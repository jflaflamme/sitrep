<?xml version="1.0"?>
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application id="f1e0a66cda0946338ed1ba75334e0a35" type="watchface" name="@Strings.AppName" entry="SitrepApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.2.0" version="0.3.0">
        <!-- tactix 7 Pro (part 006-B4135-00) is the fenix7x device in the Connect IQ SDK -->
        <iq:products>
            <iq:product id="fenix7x"/>
        </iq:products>
        <iq:permissions>
            <!-- last known position for sunrise and sunset; the face never turns GPS on -->
            <iq:uses-permission id="Positioning"/>
            <!-- body battery, stress, pressure, elevation and temperature samples -->
            <iq:uses-permission id="SensorHistory"/>
            <!-- heart rate zones, for the alien in the top zone -->
            <iq:uses-permission id="UserProfile"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
